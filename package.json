{
  "name": "kendara",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm build:chart-renderer && next dev",
    "build": "pnpm build:chart-renderer && next build",
    "build:chart-renderer": "node scripts/build-chart-renderer.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "seed-locations": "ts-node --transpile-only -P scripts/tsconfig.scripts.json -r tsconfig-paths/register scripts/seed-locations.ts",
    "sync-user-indexes": "ts-node --transpile-only -P scripts/tsconfig.scripts.json -r tsconfig-paths/register scripts/sync-user-indexes.ts",
    "recalculate-horoscopes": "pnpm build:chart-renderer && ts-node --transpile-only -P scripts/tsconfig.scripts.json -r tsconfig-paths/register -r ./scripts/load-env.js scripts/recalculate-horoscopes.ts",
    "regenerate-chart-images": "pnpm build:chart-renderer && ts-node --transpile-only -P scripts/tsconfig.scripts.json -r tsconfig-paths/register -r ./scripts/load-env.js scripts/regenerate-chart-images.ts",
    "migrate-storage": "ts-node --transpile-only -P scripts/tsconfig.scripts.json -r ./scripts/load-env.js scripts/migrate-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@google/generative-ai": "^0.24.1",
    "@qdrant/js-client-rest": "^1.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xenova/transformers": "^2.17.2",
    "date-fns": "^4.4.0",
    "jyotish-calculations": "^1.0.8",
    "mongoose": "^9.13.1",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "next-intl": "^4.16.2",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swisseph-v2": "^1.1.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.8"
  }
}