{
  "name": "@kendara/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:schemas": "ts-node --project tsconfig.scripts.json scripts/generateSchemas.ts",
    "predev": "npm run generate:schemas",
    "prebuild": "npm run generate:schemas",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "mongodb": "^7.2.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-json-schema": "^0.67.1"
  }
}
